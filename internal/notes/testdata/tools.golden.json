[
  {
    "annotations": {
      "destructiveHint": false,
      "idempotentHint": false,
      "openWorldHint": false,
      "readOnlyHint": false
    },
    "description": "Adds a note and returns its id. Never overwrites: a second note with the same title in the same second is refused.",
    "inputSchema": {
      "additionalProperties": false,
      "properties": {
        "body": {
          "description": "the note's text",
          "type": "string"
        },
        "tags": {
          "description": "the note's tags, at most 32 characters each; case-insensitive, so Go and go are one tag",
          "items": {
            "type": "string"
          },
          "type": [
            "null",
            "array"
          ]
        },
        "title": {
          "description": "the note's title, at most 80 characters",
          "type": "string"
        }
      },
      "required": [
        "title"
      ],
      "type": "object"
    },
    "name": "add_note",
    "outputSchema": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string"
        }
      },
      "required": [
        "id"
      ],
      "type": "object"
    }
  },
  {
    "annotations": {
      "destructiveHint": true,
      "idempotentHint": false,
      "openWorldHint": false,
      "readOnlyHint": false
    },
    "description": "Deletes the note with the given id, permanently. Says so when no note has that id.",
    "inputSchema": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "description": "the id of the note to delete, as add_note or list_notes gave it",
          "type": "string"
        }
      },
      "required": [
        "id"
      ],
      "type": "object"
    },
    "name": "delete_note",
    "outputSchema": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string"
        }
      },
      "required": [
        "id"
      ],
      "type": "object"
    }
  },
  {
    "annotations": {
      "idempotentHint": false,
      "openWorldHint": false,
      "readOnlyHint": true
    },
    "description": "Lists the newest notes, their ids, titles and tags, or only those carrying a given tag.",
    "inputSchema": {
      "additionalProperties": false,
      "properties": {
        "limit": {
          "description": "how many notes to return, newest first: 1 to 100, 20 if not given",
          "type": [
            "null",
            "integer"
          ]
        },
        "tag": {
          "description": "only the notes carrying this tag, case-insensitive; every note if not given",
          "type": [
            "null",
            "string"
          ]
        }
      },
      "type": "object"
    },
    "name": "list_notes",
    "outputSchema": {
      "additionalProperties": false,
      "properties": {
        "notes": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string"
              },
              "tags": {
                "items": {
                  "type": "string"
                },
                "type": [
                  "null",
                  "array"
                ]
              },
              "title": {
                "type": "string"
              }
            },
            "required": [
              "id",
              "title"
            ],
            "type": "object"
          },
          "type": [
            "null",
            "array"
          ]
        }
      },
      "required": [
        "notes"
      ],
      "type": "object"
    }
  }
]
