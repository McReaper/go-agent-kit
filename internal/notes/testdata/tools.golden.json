        "id": {
          "description": "the note's id, as add_note and list_notes return it",
          "type": "string"
        },
        "title": {
          "description": "the new title, at most 80 characters; leave it out to keep the title",
          "type": "string"
        }
      },
      "required": [
        "id"
      ],
      "type": "object"
    },
    "name": "edit_note",
    "outputSchema": {
