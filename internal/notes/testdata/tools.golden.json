    "description": "Adds a note under the tags given, case-insensitive, and returns its id. Never overwrites: a second note with the same title in the same second is refused.",
    "inputSchema": {
      "additionalProperties": false,
      "properties": {
        "body": {
          "description": "the note's text",
          "type": "string"
        },
        "tags": {
          "description": "tags to file the note under, case-insensitive, each at most 32 characters",
          "items": {
            "type": "string"
          },
          "type": [
            "null",
            "array"
          ]
        },
        "title": {
          "description": "the note's title, at most 80 characters",
          "type": "string"
        }
      },
      "required": [
        "title"
      ],
      "type": "object"
    },
    "name": "add_note",
    "outputSchema": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string"
        }
      },
      "required": [
        "id"
      ],
      "type": "object"
    }
  },
  {
    "annotations": {
      "destructiveHint": true,
      "idempotentHint": false,
      "openWorldHint": false,
      "readOnlyHint": false
    },
    "description": "Deletes the note with the given id, as add_note and list_notes return it. Refuses an id no note has, and says so.",
    "inputSchema": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "description": "the id of the note to delete, as add_note and list_notes return it",
          "type": "string"
        }
      },
      "required": [
        "id"
      ],
      "type": "object"
    },
    "name": "delete_note",
    "outputSchema": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string"
        }
      },
      "required": [
        "id"
      ],
      "type": "object"
    }
  },
  {
    "annotations": {
      "idempotentHint": false,
      "openWorldHint": false,
      "readOnlyHint": true
    },
