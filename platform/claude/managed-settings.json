{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "extraKnownMarketplaces": {
    "rumblestrip-go": {
      "source": {
        "source": "github",
        "repo": "McReaper/rumblestrip-go"
      },
      "autoUpdate": true
    }
  },
  "enabledPlugins": {
    "rumblestrip@rumblestrip-go": true
  },
  "permissions": {
    "deny": [
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git push * +*)",
      "Bash(git push --force-with-lease * main)",
      "Bash(git push --force-with-lease * main:*)",
      "Bash(git push --force-with-lease * *:main)",
      "Bash(git commit --no-verify *)",
      "Bash(git commit -n *)",
      "Bash(gh pr merge *)",
      "Bash(gh api * rulesets *)",
      "Edit(./.rumblestrip/**)",
      "Write(./.rumblestrip/**)",
      "Edit(./.github/**)",
      "Write(./.github/**)",
      "Edit(./.claude/**)",
      "Write(./.claude/**)"
    ]
  }
}
