{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "extraKnownMarketplaces": {
    "go-agent-kit": {
      "source": { "source": "github", "repo": "McReaper/go-agent-kit" },
      "autoUpdate": true
    }
  },
  "enabledPlugins": { "kit@go-agent-kit": true },
  "permissions": {
    "deny": [
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git push * +*)",
      "Bash(git push --force-with-lease * main)",
      "Bash(git push --force-with-lease * main:*)",
      "Bash(git push --force-with-lease * *:main)",
      "Bash(git commit --no-verify *)",
      "Bash(git commit -n *)",
      "Bash(gh pr merge *)",
      "Bash(gh api * rulesets *)",
      "Edit(./.kit/**)",
      "Write(./.kit/**)",
      "Edit(./.github/**)",
      "Write(./.github/**)",
      "Edit(./.claude/**)",
      "Write(./.claude/**)"
    ]
  }
}
