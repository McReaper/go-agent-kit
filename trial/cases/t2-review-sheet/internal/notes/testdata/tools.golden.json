          "type": "string"
        },
        "title": {
          "description": "the note's title, at most 80 characters",
          "type": "string"
        }
      },
      "required": [
        "title"
      ],
      "type": "object"
    },
    "name": "add_note",
    "outputSchema": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string"
        }
      },
      "required": [
        "id"
      ],
      "type": "object"
    }
  },
  {
    "annotations": {
      "idempotentHint": false,
      "openWorldHint": false,
      "readOnlyHint": true
    },
    "description": "Lists the newest notes, their ids and titles.",
    "inputSchema": {
      "additionalProperties": false,
      "properties": {
